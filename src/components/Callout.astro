---
import {whatsapp} from '../data/site';
const {title='Vamos conversar sobre a sua obra?',text='Envie o tipo de serviço, a cidade e as informações que já tem. Fotos, medidas e projeto ajudam a iniciar o orçamento.'}=Astro.props;
---
<section class="callout wrap"><div><span class="eyebrow">Seu próximo projeto</span><h2>{title}</h2><p>{text}</p></div><a class="button light" href={whatsapp()} target="_blank" rel="noopener noreferrer">Peça seu orçamento <span aria-hidden="true">↗</span></a></section>
