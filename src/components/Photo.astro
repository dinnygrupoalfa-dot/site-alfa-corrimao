---
import images from '../data/images.json';
import newImages from '../data/new-images.json';
interface Props { id: string; eager?: boolean; class?: string; sizes?: string; }
const {id,eager=false,class:className='',sizes='(max-width: 700px) 100vw, 60vw'}=Astro.props;
const added = newImages.find(image=>image.id===id);
const image=added ?? images.find(image=>image.id===id);
if(!image) throw new Error('Imagem não catalogada: '+id);
const src=added?'/images/'+added.asset:'/images/'+id.toLowerCase()+'-1280.webp';
const srcset=added?undefined:'/images/'+id.toLowerCase()+'-640.webp 640w, /images/'+id.toLowerCase()+'-1280.webp 1280w';
---
<img class={className} src={src} srcset={srcset} sizes={sizes}
 alt={image.alt} width={image.width} height={image.height}
 loading={eager?'eager':'lazy'} decoding="async" fetchpriority={eager?'high':'auto'} data-image-id={id} />
