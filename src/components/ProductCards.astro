---
import Photo from './Photo.astro';
import HomeProductGallery from './HomeProductGallery.astro';
import {homeProductGalleries} from '../data/home-gallery';
import {products} from '../data/site';
interface Props {all?:boolean; galleries?:boolean;}
const {all=true,galleries=false}=Astro.props;
---
<div class:list={['product-grid',{'two-columns':!all}]}>
  {(all?products:products.slice(0,2)).map(p => galleries ? (
    <article class="product-card home-product-card">
      <HomeProductGallery slides={homeProductGalleries[p.id as keyof typeof homeProductGalleries]} name={'Fotos de '+p.title} intervalMs={3000}/>
      <div class="product-card-body">
        <span class="eyebrow">{p.eyebrow}</span>
        <h3>{p.title}</h3>
        <p>{p.text}</p>
        <a class="text-link" href={p.href}>Conhecer produto <span aria-hidden="true">↗</span></a>
      </div>
    </article>
  ) : (
    <a class="product-card" href={p.href}>
      <div class="photo-frame"><Photo id={p.image} sizes="(max-width: 650px) 100vw, 45vw"/></div>
      <div class="product-card-body"><span class="eyebrow">{p.eyebrow}</span><h3>{p.title}</h3><p>{p.text}</p><span class="text-link">Ver solução <span aria-hidden="true">↗</span></span></div>
    </a>
  ))}
</div>