---
import Layout from '../layouts/Layout.astro';
import LandingCarousel from '../components/LandingCarousel.astro';
import {site,whatsapp} from '../data/site';
import '../styles/landing.css';

// Fotos reais preservadas no acervo Alfa. Códigos AC correspondem às fotografias de origem;
// ACF são os IDs de rastreabilidade usados pelo site Astro. Material visível na foto não
// comprova a liga metálica; o produto é descrito conforme as informações da empresa.
const escadarias = [
 {src:'/images/acf-001-1280.webp',alt:'Escadaria em dois lances com corrimãos brancos duplos fixados às paredes.',label:'Escadarias / Parede',title:'Corrimãos duplos acompanhando dois lances.',code:'Acervo AC-370 · ACF-001'},
 {src:'/images/landing-escada-ac363.jpg',alt:'Corrimãos pretos contornando o patamar de uma escadaria.',label:'Escadarias / Preto',title:'Contorno do patamar em acabamento escuro.',code:'Acervo AC-363'},
 {src:'/images/landing-escada-ac371.jpg',alt:'Escadaria em concreto com corrimãos duplos brancos nas laterais.',label:'Escadarias / Dois lados',title:'Dois níveis de apoio nas paredes.',code:'Acervo AC-371'},
 {src:'/images/acf-009-1280.webp',alt:'Escada com piso escuro e corrimãos brancos duplos nas duas paredes.',label:'Escadarias / Vista geral',title:'Corrimãos brancos em escada de edifício.',code:'Acervo AC-366 · ACF-009'},
 {src:'/images/landing-escada-ac374.jpg',alt:'Mudança de direção de corrimãos brancos em patamar.',label:'Escadarias / Detalhe',title:'Continuidade no encontro entre lances.',code:'Acervo AC-374'},
 {src:'/images/landing-escada-ac369.jpg',alt:'Escadaria interna com corrimãos duplos brancos e patamar.',label:'Escadarias / Instalação',title:'Percurso acompanhado pelos corrimãos.',code:'Acervo AC-369'},
 {src:'/images/acf-007-1280.webp',alt:'Detalhe do encontro de corrimãos brancos em um patamar.',label:'Escadarias / Acabamento',title:'Detalhes das fixações e do percurso.',code:'Acervo AC-380 · ACF-007'},
 {src:'/images/landing-escada-ac372.jpg',alt:'Corrimãos brancos acompanhando um canto de patamar.',label:'Escadarias / Contorno',title:'Solução para mudanças de direção.',code:'Acervo AC-372'},
 {src:'/images/landing-escada-ac377.jpg',alt:'Detalhe das terminações de corrimãos na parede da escadaria.',label:'Escadarias / Terminações',title:'Acabamento das extremidades.',code:'Acervo AC-377'},
 {src:'/images/landing-escada-ac364.jpg',alt:'Corrimãos pretos em escadaria de concreto e patamar.',label:'Escadarias / Preto',title:'Outra opção de acabamento para escadas.',code:'Acervo AC-364'}
];
const rampas = [
 {src:'/images/acf-003-1280.webp',alt:'Rampa externa sinuosa com corrimãos metálicos em duas alturas e vegetação ao lado.',label:'Rampas / Acesso externo',title:'Corrimãos acompanhando o percurso da rampa.',code:'ACF-003'},
 {src:'/images/landing-rampa-paralelas.jpg',alt:'Duas rampas paralelas de entrada de edifício com corrimãos metálicos.',label:'Rampas / Prédios',title:'Rampas paralelas em acesso de edifício.',code:'Acervo Alfa / rampas'},
 {src:'/images/landing-rampa-fachada-vidro.jpg',alt:'Rampa de acesso junto a fachada de vidro e corrimãos de metal polido.',label:'Rampas / Fachada',title:'Acesso ao condomínio junto à fachada.',code:'Acervo Alfa / rampas'},
 {src:'/images/acf-004-1280.webp',alt:'Rampa reta com dois corrimãos paralelos em cada lateral.',label:'Rampas / Acessibilidade',title:'Apoio em duas alturas na entrada.',code:'ACF-004'},
 {src:'/images/landing-rampa-jardim.jpg',alt:'Rampa com corrimão metálico junto a jardim de condomínio.',label:'Rampas / Jardim',title:'Percurso de acesso em área externa.',code:'Acervo Alfa / rampas'},
 {src:'/images/landing-rampa-longa-fachada.jpg',alt:'Rampa longa em frente a edifício envidraçado, com corrimãos metálicos.',label:'Rampas / Percursos',title:'Solução para acessos de maior extensão.',code:'Acervo Alfa / rampas'},
 {src:'/images/landing-rampa-comercio.jpg',alt:'Corrimãos metálicos duplos em rampa de acesso a comércio.',label:'Rampas / Comércio',title:'Rampa em entrada comercial.',code:'Acervo Alfa / rampas'},
 {src:'/images/acf-011-1280.webp',alt:'Rampa externa com corrimãos metálicos e escadaria ao lado de fachada de edifício.',label:'Rampas / Edifícios',title:'Escada e rampa na mesma obra.',code:'ACF-011'},
 {src:'/images/landing-rampa-longa-predio.jpg',alt:'Percurso longo de rampa em prédio com corrimãos metálicos.',label:'Rampas / Percurso longo',title:'Corrimãos ao longo da circulação.',code:'Acervo Alfa / rampas'},
 {src:'/images/landing-rampa-acesso-frontal.jpg',alt:'Acesso frontal a edifício com corrimão metálico em rampa.',label:'Rampas / Entrada',title:'Acessos de edifícios e condomínios.',code:'Acervo Alfa / rampas'}
];
const cores=[
 {name:'Branco',swatch:'#e9e9e5'},
 {name:'Preto',swatch:'#222326'},
 {name:'Bronze',swatch:'#80674f'},
 {name:'RAL 9006',swatch:'#a6a8a8'},
 {name:'RAL 9007',swatch:'#7d7f7d'},
 {name:'RAL 7034F',swatch:'#9f9a7a'}
];
const nomeServico='Corrimão para escadaria ou rampa';
---
<Layout title="Corrimãos de Parede NBR 9050 para Prédios" description="Corrimão duplo de alumínio para escadarias e corrimão duplo em inox para rampas de acessibilidade. Soluções Alfa Corrimão para prédios e condomínios. Solicite orçamento.">
<div class="landing">
  <section class="lp-top">
    <div class="wrap">
      <div class="lp-breadcrumb"><a href="/">Início</a><span>/</span><span>Corrimãos para prédios e acessos</span></div>
      <div class="lp-top-grid">
        <div>
          <span class="eyebrow"><span class="red-line"></span> Alfa Corrimão / Escadarias e rampas</span>
          <h1>Corrimãos de parede para <em>escadarias e rampas.</em></h1>
          <p class="lp-lead">Corrimão duplo de alumínio para escadarias de prédios e corrimão duplo em inox para rampas de acessibilidade. Atendimento para obras novas, condomínios e readequações, com referência à <strong>ABNT NBR 9050</strong>.</p>
          <div class="lp-actions">
            <a class="button" href="#escadarias">Corrimão para escadaria ↗</a>
            <a class="lp-outline" href="#rampas">Corrimão para rampa ↗</a>
          </div>
          <p class="lp-muted">Solicite orçamento sem compromisso. Atendimento direto com o engenheiro Ernani: <a class="lp-anchor-link" href={'tel:+55'+site.phone}>{site.phoneLabel}</a>.</p>
          <div class="lp-facts"><span>Duas alturas de apoio</span><span>Alumínio e inox</span><span>Contrato e proposta por obra</span></div>
        </div>
        <LandingCarousel slides={[escadarias[0],rampas[0],escadarias[1],rampas[1],escadarias[2],rampas[2]]} name="Fotografias de corrimãos da Alfa em escadarias e rampas" intervalMs={3500}/>
      </div>
    </div>
  </section>
  <nav class="lp-quicknav" aria-label="Acessos diretos aos produtos">
    <div class="wrap lp-quicknav-inner">
      <a href="#escadarias">01 / Corrimão duplo de alumínio para escadarias</a>
      <a href="#rampas">02 / Corrimão duplo de inox para rampas</a>
      <a href="#orcamento">Solicitar orçamento</a>
      <small>Um só fornecedor para os dois serviços.</small>
    </div>
  </nav>

  <section id="normas" class="lp-technical">
    <div class="wrap">
      <span class="eyebrow">Acessibilidade e segurança</span>
      <div class="lp-section-heading">
        <h2>O corrimão faz parte da <em>adequação do edifício.</em></h2>
        <p>A NBR 9050 apresenta critérios de projeto e instalação para corrimãos em escadas e rampas. Os detalhes devem ser avaliados de acordo com a edificação e as normas aplicáveis ao projeto. Uma instalação inadequada pode resultar em exigências durante a vistoria.</p>
      </div>
      <div class="lp-card-grid">
        <article class="lp-card"><b>Duas alturas de apoio</b><p>O documento técnico da Alfa considera corrimãos a 0,70 m e 0,92 m, conforme o contexto de escadas e rampas.</p></article>
        <article class="lp-card"><b>Continuidade do percurso</b><p>Avaliamos lances, patamares, mudanças de direção e prolongamentos necessários em cada projeto.</p></article>
        <article class="lp-card"><b>Acabamento e fixação</b><p>Empunhadura, distância da parede, terminações, contraste e sinalização são verificados conforme a aplicação.</p></article>
      </div>
      <p class="lp-note">A Alfa fornece e instala corrimãos. A emissão do AVCB depende do processo e das autoridades competentes; a instalação de um único item não garante aprovação da vistoria.</p>
    </div>
  </section>

  <section id="escadarias" class="lp-section">
    <div class="wrap">
      <div class="lp-section-heading">
        <span class="eyebrow">01 / Solução para escadarias</span>
        <h2>Corrimão duplo de <em>alumínio</em> para escadarias de prédios.</h2>
        <p>Corrimão de parede contínuo para escadas de edifícios residenciais, comerciais e industriais, incluindo escadarias de emergência. Fabricação e instalação de acordo com o escopo e as exigências aplicáveis à obra.</p>
      </div>
      <div class="lp-product-grid">
        <LandingCarousel slides={escadarias} name="Fotografias reais de corrimãos em escadarias" intervalMs={3500}/>
        <div>
          <span class="eyebrow">Produto / Alumínio</span>
          <p class="lp-lead">Do lance ao patamar, uma solução em duas alturas de apoio, com fixação na parede e traçado adaptado à escadaria.</p>
          <p>O corrimão duplo não é uma opção reservada apenas a escadas largas: a configuração deve atender aos requisitos normativos e ao projeto. Em escadarias de maior largura, a avaliação também considera a necessidade de corrimão intermediário.</p>
          <p class="lp-product-bullet">Alumínio, estrutura leve, versatilidade, facilidade de manutenção e agilidade de instalação.</p>
          <div class="lp-actions">
            <a class="button" href="#orcamento" data-product-link="Corrimão duplo de alumínio para escadaria">Solicitar orçamento ↗</a>
            <a class="lp-outline" href={whatsapp('Olá, Ernani. Gostaria de um orçamento de corrimão duplo de alumínio para escadaria de prédio.')} target="_blank" rel="noopener noreferrer">Falar com o engenheiro</a>
          </div>
        </div>
      </div>
      <h3 class="lp-section-sub">Especificações do produto</h3>
      <table class="lp-specs" aria-label="Especificações do corrimão de alumínio">
        <tbody>
          <tr><th>Material</th><td>Corrimão de parede duplo em alumínio, com tubo redondo e acessórios em alumínio.</td></tr>
          <tr><th>Bitola do tubo</th><td>Tubo redondo de 38,1 mm, conforme informação técnica fornecida pela Alfa.</td></tr>
          <tr><th>Aplicações</th><td>Escadarias de prédios residenciais, comerciais, industriais e escadas de emergência.</td></tr>
          <tr><th>Instalação</th><td>Fixação na parede e continuidade definida pelas condições do percurso.</td></tr>
          <tr><th>Referências</th><td>ABNT NBR 9050 e demais normas e requisitos aplicáveis à edificação e às saídas de emergência.</td></tr>
        </tbody>
      </table>
      <h3 class="lp-section-sub">Cores e acabamentos</h3>
      <p class="lp-muted">Branco, preto, bronze e tons de cinza informados no levantamento comercial da Alfa. As amostras abaixo são apenas referências visuais; confirmar a cor exata e a disponibilidade na proposta.</p>
      <div class="lp-colors">{cores.map(c=><div class="lp-color"><i style={'--swatch:'+c.swatch} aria-hidden="true"></i><span>{c.name}</span></div>)}</div>
      <p class="lp-note">A referência “RAL 7034F” está reproduzida como informada no material original; a codificação e o acabamento deverão ser confirmados com o fornecedor. O contraste com as paredes também deve ser avaliado.</p>
    </div>
  </section>

  <section id="rampas" class="lp-section">
    <div class="wrap">
      <div class="lp-section-heading">
        <span class="eyebrow">02 / Solução para rampas de acessibilidade</span>
        <h2>Corrimão duplo em <em>inox</em> para rampas de acesso.</h2>
        <p>Corrimãos de duas alturas para rampas de acesso de pessoas com deficiência ou mobilidade reduzida, em edifícios, condomínios e empreendimentos. O projeto orienta o traçado, as fixações e os detalhes de acabamento.</p>
      </div>
      <div class="lp-product-grid">
        <LandingCarousel slides={rampas} name="Fotografias reais de corrimãos em rampas" intervalMs={3500}/>
        <div>
          <span class="eyebrow">Produto / Inox</span>
          <p class="lp-lead">Duas alturas de apoio em cada lado, continuidade dos corrimãos e acabamento adequado ao ambiente de instalação.</p>
          <p>A proposta considera o uso em rampa, os acessos, os patamares, as extremidades e as exigências aplicáveis da NBR 9050. A solução em inox complementa o corrimão de alumínio das escadarias.</p>
          <p class="lp-product-bullet">Alumínio para escadarias e inox para rampas: soluções complementares para uma mesma obra.</p>
          <div class="lp-actions">
            <a class="button" href="#orcamento" data-product-link="Corrimão duplo de inox para rampa">Solicitar orçamento ↗</a>
            <a class="lp-outline" href={whatsapp('Olá, Ernani. Gostaria de um orçamento de corrimão duplo de inox para rampa de acessibilidade.')} target="_blank" rel="noopener noreferrer">Falar com o engenheiro</a>
          </div>
        </div>
      </div>
      <div class="lp-card-grid">
        <article class="lp-card"><b>Duas alturas em cada lado</b><p>O percurso da rampa exige uma solução que atenda à acessibilidade, com as alturas de apoio previstas no projeto.</p></article>
        <article class="lp-card"><b>Inox para acessos e áreas externas</b><p>Material proposto para rampas da Alfa. Liga, acabamento e fixações são detalhados na proposta técnica.</p></article>
        <article class="lp-card"><b>Continuidade e prolongamentos</b><p>O desenho da rampa e seus patamares orientam a continuidade dos corrimãos e o tratamento das extremidades.</p></article>
      </div>
    </div>
  </section>

  <section class="lp-close">
    <div class="wrap lp-close-grid">
      <div>
        <span class="eyebrow">Dois produtos / Um fornecedor</span>
        <h2>Escadaria e rampa <em>no mesmo projeto.</em></h2>
      </div>
      <div>
        <p>O cliente que precisa adequar a escadaria também pode precisar de corrimãos para a rampa de acesso. A Alfa reúne as duas soluções, em alumínio e inox, em uma única conversa sobre a obra.</p>
        <a class="button" href="#orcamento" data-product-link="Escadaria e rampa no mesmo projeto">Apresentar os dois serviços ↗</a>
      </div>
    </div>
  </section>

  <section class="lp-feature">
    <div class="wrap">
      <div class="lp-feature-grid">
        <div>
          <span class="eyebrow">Transparência comercial</span>
          <h2>Como funciona <em>a contratação.</em></h2>
        </div>
        <div>
          <p>O contrato define o escopo, os prazos e os marcos de pagamento. Conforme o processo descrito pela Alfa, não há cobrança no ato da assinatura do contrato. O sinal e o saldo seguem as condições acordadas para cada obra.</p>
          <p class="lp-note">A data de entrega dos materiais, eventual armazenagem e outras condições operacionais são tratadas na proposta e no contrato, não como promessa genérica nesta página.</p>
        </div>
      </div>
      <div class="lp-steps">
        <article class="lp-step"><span class="lp-number">01 / Contratação</span><b>Contrato assinado</b><p>Escopo, material, prazo e condições de pagamento definidos por escrito.</p></article>
        <article class="lp-step"><span class="lp-number">02 / Preparação</span><b>Material reservado</b><p>A Alfa organiza a compra e a preparação dos materiais da obra contratada.</p></article>
        <article class="lp-step"><span class="lp-number">03 / Faturamento</span><b>Material e sinal</b><p>O sinal é vinculado ao marco de entrega ou disponibilização acordado em contrato.</p></article>
        <article class="lp-step"><span class="lp-number">04 / Execução</span><b>Instalação concluída</b><p>O saldo segue as condições de conclusão e conferência combinadas com o cliente.</p></article>
      </div>
    </div>
  </section>

  <section class="lp-section" id="atendimento">
    <div class="wrap">
      <div class="lp-section-heading">
        <span class="eyebrow">Construtoras e condomínios</span>
        <h2>Do planejamento à <em>readequação.</em></h2>
        <p>Atendemos demandas de obras novas, condomínios e contratação por etapas. Você pode apresentar um produto ou as duas soluções juntas.</p>
      </div>
      <div class="lp-card-grid">
        <article class="lp-card"><b>01 / Obra nova</b><p>Informe a cidade, a etapa da obra, as torres ou blocos e as informações disponíveis sobre a escadaria e a rampa.</p></article>
        <article class="lp-card"><b>02 / Condomínio</b><p>Apresente as necessidades de readequação e o prazo previsto para liberação do local.</p></article>
        <article class="lp-card"><b>03 / Fale com o engenheiro</b><p>Tire suas dúvidas diretamente com Ernani. Se preferir, envie fotos e medidas antes da conversa.</p></article>
      </div>
    </div>
  </section>

  <section id="orcamento" class="lp-contact">
    <div class="wrap lp-contact-grid">
      <form class="quote-form" data-quote-form data-wa={'55'+site.phone}>
        <span class="eyebrow">Orçamento / Sem compromisso</span>
        <h2>Apresente sua escadaria ou rampa.</h2>
        <p>Preencha as informações que tiver. O WhatsApp abrirá com a mensagem pronta para você conferir e enviar ao engenheiro Ernani.</p>
        <div class="form-grid">
          <label>Seu nome <span aria-hidden="true">*</span><input name="nome" autocomplete="name" required maxlength="100"/></label>
          <label>WhatsApp ou telefone <span aria-hidden="true">*</span><input name="telefone" type="tel" autocomplete="tel" required pattern="[0-9()+ .-]{10,20}" title="Informe um telefone com DDD." maxlength="20"/></label>
          <label>Empresa ou condomínio<input name="empresa" autocomplete="organization" maxlength="150"/></label>
          <label>Cidade e estado <span aria-hidden="true">*</span><input name="cidade" autocomplete="address-level2" required maxlength="120"/></label>
          <label>Torres ou blocos<input name="torres" type="text" maxlength="60" placeholder="Ex.: 2 torres"/></label>
          <label>Número de pavimentos<input name="pavimentos" type="number" min="1" max="200" placeholder="Se souber"/></label>
          <label class="full">Serviço desejado <span aria-hidden="true">*</span>
            <select name="servico" required data-landing-service>
              <option value="">Selecione o serviço</option>
              <option>Corrimão duplo de alumínio para escadaria</option>
              <option>Corrimão duplo de inox para rampa</option>
              <option>Escadaria e rampa no mesmo projeto</option>
            </select>
          </label>
          <label class="full">Sobre a sua obra<textarea name="mensagem" rows="4" maxlength="2000" placeholder="Etapa da obra, fotos ou medidas disponíveis, necessidade e prazo estimado."></textarea></label>
        </div>
        <p class="form-note">* Campos obrigatórios. Os dados são colocados somente na mensagem do WhatsApp, para sua conferência e envio. Consulte a <a href="/politica-de-privacidade/">Política de Privacidade</a>.</p>
        <button class="button" type="submit">Continuar no WhatsApp ↗</button>
        <p role="status" aria-live="polite" data-form-status></p>
        <noscript><p>Para utilizar o formulário, ative o JavaScript ou <a href={whatsapp()}>acesse diretamente o WhatsApp</a>.</p></noscript>
      </form>
      <aside class="contact-card">
        <span class="eyebrow">Atendimento técnico</span>
        <h2>Converse com o engenheiro Ernani.</h2>
        <p>Solicite seu orçamento, apresente o projeto e tire dúvidas sobre as duas aplicações.</p>
        <a class="contact-phone" href={'tel:+55'+site.phone}>{site.phoneLabel}</a>
        <a class="button" href={whatsapp('Olá, Ernani. Gostaria de solicitar um orçamento de corrimão para meu empreendimento.')} target="_blank" rel="noopener noreferrer">Abrir WhatsApp ↗</a>
        <hr/>
        <p>Telefone: <a href={'tel:'+site.landlineHref}>{site.landline}</a></p>
        <p><a href={'mailto:'+site.email}>{site.email}</a></p>
        <p class="lp-note">O envio do formulário depende da confirmação no seu aplicativo WhatsApp.</p>
      </aside>
    </div>
  </section>
</div>
<script>
  const service = document.querySelector<HTMLSelectElement>('[data-landing-service]');
  function preselect(){
    if (!service || service.value) return;
    if (location.hash === '#escadarias') service.value='Corrimão duplo de alumínio para escadaria';
    if (location.hash === '#rampas') service.value='Corrimão duplo de inox para rampa';
  }
  preselect();
  window.addEventListener('hashchange',preselect);
  document.querySelectorAll<HTMLAnchorElement>('[data-product-link]').forEach(link=>link.addEventListener('click',()=>{
    if (!service) return;
    service.value=link.dataset.productLink||'';
  }));
</script>
</Layout>
