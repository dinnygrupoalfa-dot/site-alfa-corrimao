 {"src":"/images/landing-20261118/RMP-06-rampa-fachada-condominio-guarda-corpos-metalicos.jpeg","alt":"Acesso ao condomínio com rampa e guarda-corpos metálicos.","label":"Rampas / Obra real","title":"Acesso ao condomínio com rampa e guarda-corpos metálicos.","code":"Foto RMP-06 · Acervo Alfa"},
