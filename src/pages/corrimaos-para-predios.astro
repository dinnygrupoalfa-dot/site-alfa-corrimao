const rampas = [
 {"src":"/images/landing-20261118/RMP-01-rampa-acesso-externa-corrimaos-metalicos-vista-superior.jpeg","alt":"Rampa externa com corrimãos metálicos e guarda-corpo de vidro.","label":"Rampas / Obra real","title":"Rampa externa com corrimãos metálicos e guarda-corpo de vidro.","code":"Foto RMP-01 · Acervo Alfa"},
 {"src":"/images/landing-20261118/RMP-02-rampa-e-escadaria-degraus-azuis-condominio.jpeg","alt":"Rampa e escadaria com degraus azuis na entrada do edifício.","label":"Rampas / Obra real","title":"Rampa e escadaria com degraus azuis na entrada do edifício.","code":"Foto RMP-02 · Acervo Alfa"},
 {"src":"/images/landing-20261118/RMP-03-rampa-acesso-corrimaos-metalicos-jardim.jpeg","alt":"Rampa externa com corrimãos metálicos junto ao jardim.","label":"Rampas / Obra real","title":"Rampa externa com corrimãos metálicos junto ao jardim.","code":"Foto RMP-03 · Acervo Alfa"},
 {"src":"/images/landing-20261118/RMP-04-rampa-corredor-externo-corrimaos-vista-frontal.jpeg","alt":"Rampa em corredor externo com corrimãos laterais.","label":"Rampas / Obra real","title":"Rampa em corredor externo com corrimãos laterais.","code":"Foto RMP-04 · Acervo Alfa"},
 {"src":"/images/landing-20261118/RMP-05-rampa-corredor-externo-corrimaos-vista-alternativa.jpeg","alt":"Outra vista da rampa longa em corredor externo.","label":"Rampas / Obra real","title":"Outra vista da rampa longa em corredor externo.","code":"Foto RMP-05 · Acervo Alfa"},
 {"src":"/images/landing-20261118/RMP-06-rampa-fachada-condominio-guarda-corpos-metalicos.jpeg","alt":"Acesso ao condomínio com rampa e guarda-corpos metálicos.","label":"Rampas / Obra real","title":"Acesso ao condomínio com rampa e guarda-corpos metálicos.","code":"Foto RMP-06 · Acervo Alfa"},
 {"src":"/images/landing-20261118/RMP-07-rampa-e-escadaria-corrimaos-acesso-predio.jpeg","alt":"Rampa e escadaria próximas à fachada do edifício.","label":"Rampas / Obra real","title":"Rampa e escadaria próximas à fachada do edifício.","code":"Foto RMP-07 · Acervo Alfa"},
 {"src":"/images/landing-20261118/RMP-08-rampa-externa-corrimaos-metalicos-vista-lateral.jpeg","alt":"Vista lateral de rampa externa com corrimãos.","label":"Rampas / Obra real","title":"Vista lateral de rampa externa com corrimãos.","code":"Foto RMP-08 · Acervo Alfa"},
 {"src":"/images/landing-20261118/RMP-09-rampa-escadaria-degraus-azuis-vista-lateral.jpeg","alt":"Outro ângulo da rampa e escada com degraus azuis.","label":"Rampas / Obra real","title":"Outro ângulo da rampa e escada com degraus azuis.","code":"Foto RMP-09 · Acervo Alfa"},
 {"src":"/images/landing-20261118/RMP-10-rampa-acesso-externa-mesma-vista-de-rmp01.jpeg","alt":"Rampa externa com corrimãos e guarda-corpo de vidro.","label":"Rampas / Obra real","title":"Rampa externa com corrimãos e guarda-corpo de vidro.","code":"Foto RMP-10 · Acervo Alfa"},
 {"src":"/images/landing-20261118/RMP-11-rampa-corrimaos-metalicos-caminhos-paralelos.jpeg","alt":"Rampas paralelas em acesso externo com corrimãos.","label":"Rampas / Obra real","title":"Rampas paralelas em acesso externo com corrimãos.","code":"Foto RMP-11 · Acervo Alfa"},
 {"src":"/images/landing-20261118/RMP-12-rampa-externa-guarda-corpos-e-corrimaos-laterais.jpeg","alt":"Rampa externa entre fachada e muro com guarda-corpos.","label":"Rampas / Obra real","title":"Rampa externa entre fachada e muro com guarda-corpos.","code":"Foto RMP-12 · Acervo Alfa"},
 {"src":"/images/landing-20261118/RMP-13-rampa-condominio-corrimaos-duplos-vista-descida.jpeg","alt":"Rampa de condomínio com corrimãos duplos nas laterais.","label":"Rampas / Obra real","title":"Rampa de condomínio com corrimãos duplos nas laterais.","code":"Foto RMP-13 · Acervo Alfa"}
