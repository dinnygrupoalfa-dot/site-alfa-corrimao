 {"src":"/images/landing-20261118/ESC-13-corrimao-duplo-preto-escada-vista-superior.jpeg","alt":"Escadaria de concreto com corrimãos pretos vista superior.","label":"Escadarias / Obra real","title":"Escadaria de concreto com corrimãos pretos vista superior.","code":"Foto ESC-13 · Acervo Alfa"},
