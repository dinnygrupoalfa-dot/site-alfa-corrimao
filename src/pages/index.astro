---
import Layout from '../layouts/Layout.astro';
import Carousel from '../components/Carousel.astro';
import Photo from '../components/Photo.astro';
import ProductCards from '../components/ProductCards.astro';
import Callout from '../components/Callout.astro';
import {site,whatsapp,technicalWhatsapp} from '../data/site';
import '../styles/home.css';

const slides=[
 {id:'ACF-127',label:'Corrimão duplo / Escadarias',title:'Apoio em duas alturas nas escadarias.',href:'/corrimaos/aluminio-escadarias/'},
 {id:'ACF-011',label:'Corrimãos / Rampas de acesso',title:'Corrimãos para acessibilidade e circulação.',href:'/corrimaos/inox-rampas/'},
 {id:'ACF-023',label:'Guarda-corpos / Áreas comuns',title:'Proteção integrada aos espaços do condomínio.',href:'/guarda-corpos/'},
 {id:'ACF-005',label:'Guarda-corpos / Vidro e metal',title:'Soluções para escadarias e áreas de acesso.',href:'/guarda-corpos/'},
 {id:'ACF-121',label:'Obras / Píer de Cubatão',title:'Detalhes de um trabalho registrado em fotografias.',href:'/obras-realizadas/pier-de-cubatao/'},
 {id:'ACF-028',label:'Soluções em vidro / Sacadas',title:'Fechamentos em vidro para edifícios.',href:'/vidro-temperado/'},
];
const clientes=[
 'Instituto Neymar Júnior',
 'Construtora Sobloco',
 'Construtora Terracon',
 'Soccer Grass',
 'Construtora Costa Hirota',
 'Construtora Árbore',
 'Construtora Phoenix',
 'Construtora PGC',
 'Prefeitura de Cubatão',
 'Quali Engenharia',
 'Jestec Engenharia',
 'Grupo Mendes Engenharia'
];
---
<Layout title="Início" description="Alfa Corrimão: fabricação e instalação de corrimãos, guarda-corpos e soluções em vidro para construtoras, edifícios e condomínios. São Bernardo do Campo – SP. Desde 2012.">
<div class="institutional-home">
  <section class="home-intro wrap" aria-labelledby="home-title">
    <div class="home-intro-copy">
      <span class="eyebrow"><span class="red-line"></span> Alfa Corrimão · São Bernardo do Campo – SP</span>
      <h1 id="home-title">Corrimãos e guarda-corpos <em>para a sua obra.</em></h1>
      <p class="home-intro-lead">Fabricação e instalação de corrimãos para escadarias e rampas, guarda-corpos e soluções em vidro para construtoras, edifícios e condomínios.</p>
      <div class="home-intro-actions">
        <a class="button" href={whatsapp('Olá! Quero solicitar um orçamento para minha obra.')} target="_blank" rel="noopener noreferrer">Solicitar orçamento <span aria-hidden="true">↗</span></a>
        <a class="home-outline-button" href="/obras-realizadas/">Conhecer nossas obras <span aria-hidden="true">↗</span></a>
      </div>
      <a class="home-intro-specialty" href="/corrimaos-para-predios/">Corrimão duplo para escadarias e rampas: conheça a solução <span aria-hidden="true">↗</span></a>
    </div>
    <div class="home-intro-visual">
      <Carousel slides={slides} name="Fotografias de corrimãos, guarda-corpos e vidro em obras" hero intervalMs={3500} noPause/>
    </div>
  </section>

  <div class="home-credentials" aria-label="Informações da Alfa Corrimão">
    <div class="wrap home-credentials-grid">
      <div><strong>Desde 2012</strong><span>Empresa registrada e estabelecida no setor</span></div>
      <div><strong>São Bernardo do Campo</strong><span>Base de atendimento em São Paulo</span></div>
      <div><strong>Construtoras e condomínios</strong><span>Produtos para obras novas e readequações</span></div>
    </div>
  </div>

  <section class="section home-services wrap" id="produtos">
    <div class="home-section-intro">
      <div><span class="eyebrow">Produtos e aplicações</span><h2>O que a Alfa <em>fabrica e instala.</em></h2></div>
      <p>Da escadaria à sacada: encontre a solução que seu empreendimento precisa e veja fotografias de aplicações reais.</p>
    </div>
    <ProductCards/>
    <div class="home-services-footer">
      <p>Precisa de corrimão duplo para escadarias e rampas na mesma obra?</p>
      <a class="text-link" href="/corrimaos-para-predios/">Conheça os dois produtos em uma página ↗</a>
    </div>
  </section>

  <section class="section section-muted home-work" id="obras">
    <div class="wrap">
      <div class="home-section-intro">
        <div><span class="eyebrow">Obras realizadas</span><h2>Veja o trabalho <em>nas fotografias.</em></h2></div>
        <p>Registros de escadarias, rampas, guarda-corpos e vidro ajudam a visualizar as soluções no contexto de cada espaço.</p>
      </div>
      <div class="home-work-grid">
        <a class="home-work-highlight" href="/obras-realizadas/pier-de-cubatao/" aria-label="Abrir o álbum com 46 fotografias do Píer de Cubatão">
          <Photo id="ACF-121" sizes="(max-width:800px) 100vw, 60vw"/>
          <span class="home-work-caption"><small>Píer de Cubatão · Álbum com 46 fotografias</small><strong>Guarda-corpos, passarelas e áreas de circulação.</strong><span>Explorar álbum ↗</span></span>
        </a>
        <div class="home-work-side">
          <a href="/corrimaos/aluminio-escadarias/">
            <Photo id="ACF-127" sizes="(max-width:800px) 100vw, 40vw"/>
            <span><strong>Escadarias de prédios</strong><small>Corrimãos duplos de parede ↗</small></span>
          </a>
          <a href="/guarda-corpos/">
            <Photo id="ACF-023" sizes="(max-width:800px) 100vw, 40vw"/>
            <span><strong>Áreas comuns</strong><small>Guarda-corpos em vidro e metal ↗</small></span>
          </a>
        </div>
      </div>
      <a class="text-link home-work-more" href="/obras-realizadas/">Ver todas as fotografias e obras ↗</a>
    </div>
  </section>

  <section class="section home-clients" id="clientes">
    <div class="wrap">
      <div class="home-section-intro">
        <div><span class="eyebrow">Experiência com empresas e instituições</span><h2>Quem já confiou <em>na Alfa Corrimão.</em></h2></div>
        <p>Alguns dos clientes atendidos pela Alfa Corrimão, apresentados sem depoimentos atribuídos ou resultados inventados.</p>
      </div>
      <ul class="home-client-names">
        {clientes.map(nome=><li>{nome}</li>)}
      </ul>
    </div>
  </section>

  <section class="section section-muted home-about" id="quem-somos">
    <div class="wrap home-about-grid">
      <div>
        <span class="eyebrow">Conheça a Alfa Corrimão</span>
        <h2>Uma empresa real.<br/><em>Experiência desde 2012.</em></h2>
        <p>A Alfa Corrimão atua na fabricação e instalação de corrimãos, guarda-corpos e soluções em vidro para obras. Está estabelecida em São Bernardo do Campo – SP e atende demandas de construtoras e condomínios.</p>
        <a class="text-link" href="/quem-somos/">Conheça a empresa ↗</a>
      </div>
      <div class="home-about-details">
        <div><span>Razão social</span><strong>Construtora Canaã Saldanha Ltda.</strong></div>
        <div><span>CNPJ</span><strong>{site.cnpj}</strong></div>
        <div><span>Localização</span><strong>{site.cityState}</strong></div>
        <div><span>Registro empresarial</span><strong>Desde setembro de 2012</strong></div>
      </div>
    </div>
  </section>

  <section class="section home-process wrap">
    <div class="home-section-intro">
      <div><span class="eyebrow">Para construtoras e condomínios</span><h2>Do projeto <em>ao orçamento.</em></h2></div>
      <p>Você não precisa ter todas as medidas prontas para iniciar uma conversa sobre a necessidade do empreendimento.</p>
    </div>
    <ol class="home-process-steps">
      <li><span>01</span><h3>Conte sobre a obra</h3><p>Informe a cidade, o tipo de edifício e quais serviços precisam de orçamento.</p></li>
      <li><span>02</span><h3>Compartilhe o que já tem</h3><p>Fotos, plantas, memorial, trechos envolvidos ou metragens aproximadas, quando disponíveis.</p></li>
      <li><span>03</span><h3>Converse com a Alfa</h3><p>O atendimento comercial recebe as informações e encaminha a solicitação para avaliação.</p></li>
    </ol>
    <div class="home-process-actions">
      <a class="button" href={whatsapp('Olá! Gostaria de apresentar um empreendimento para orçamento.')} target="_blank" rel="noopener noreferrer">Falar com o comercial ↗</a>
      <a class="text-link" href="/construtoras-e-condominios/">Atendimento para construtoras e condomínios ↗</a>
      <a class="text-link" href={technicalWhatsapp('Olá, Ernani! Gostaria de tirar dúvidas técnicas sobre uma obra.')} target="_blank" rel="noopener noreferrer">Dúvidas técnicas com Ernani ↗</a>
    </div>
  </section>

  <Callout title="Sua obra precisa de corrimãos, guarda-corpos ou vidro?" text="Apresente o serviço, a cidade e as informações disponíveis. O atendimento comercial da Alfa recebe seu pedido de orçamento."/>
</div>
</Layout>
