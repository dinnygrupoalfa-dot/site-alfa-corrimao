---
import Layout from '../../layouts/Layout.astro';
import Carousel from '../../components/Carousel.astro';
import Photo from '../../components/Photo.astro';
import Callout from '../../components/Callout.astro';
import newImages from '../../data/new-images.json';
const pier = newImages.filter(image => {const n=Number(image.id.slice(4)); return n>=115 && n<=164 && !(n>=126 && n<=129);});
const categoryFor=(image:typeof pier[number])=>{
 const name=image.originalName.toLowerCase();
 if(/pessoas|carrinho|pergolado|mobiliario|bancos|faixa-tatil/.test(name)) return 'contexto';
 if(/guarda-corpo|borda|detalhe|jardineira/.test(name)) return 'detalhes';
 return 'panoramas';
};
const labels:{[key:string]:string}={panoramas:'Vistas da obra',detalhes:'Guarda-corpos e detalhes',contexto:'Ambientes e circulação'};
const featured=[
 {id:'ACF-116',label:'Vista da obra',title:'Passarela sobre a água.'},
 {id:'ACF-121',label:'Circulação',title:'Percursos e áreas de convivência.'},
 {id:'ACF-120',label:'Guarda-corpos',title:'Proteção ao longo do píer.'},
 {id:'ACF-150',label:'Acesso',title:'Passarela e guarda-corpos.'},
 {id:'ACF-164',label:'Detalhe',title:'Vidro e metal nas bordas do deck.'}
];
---
<Layout title="Píer de Cubatão — galeria de obra" description="Galeria fotográfica do Píer de Cubatão, com registros de passarelas, guarda-corpos e áreas de circulação do acervo Alfa Corrimão.">
 <div class="wrap breadcrumb"><a href="/">Início</a><span>/</span><a href="/obras-realizadas/">Obras realizadas</a><span>/</span><span>Píer de Cubatão</span></div>
 <section class="page-heading wrap compact-top">
  <span class="eyebrow">Acervo de obras / Píer de Cubatão</span>
  <h1>Um percurso<br/>em <em>perspectiva.</em></h1>
  <p class="lead">Píer de Cubatão: registros visuais de guarda-corpos, passarelas, acessos e áreas de circulação.</p>
  <p>O álbum reúne diferentes ângulos da obra enviados pela equipe Alfa. Os materiais e o escopo de cada elemento devem ser confirmados com o responsável técnico.</p>
  <a class="text-link" href="/obras-realizadas/">← Voltar para Obras Realizadas</a>
 </section>
 <section class="wrap showcase">
  <Carousel slides={featured} name="Destaques visuais da obra Píer de Cubatão" intervalMs={3500}/>
 </section>
 <section class="section wrap" data-gallery>
  <div class="section-heading">
   <div><span class="eyebrow">Galeria completa / Acervo registrado</span><h2>46 fotografias.<br/>Uma obra.</h2></div>
   <p>Explore as imagens por vista geral, detalhes ou ambientes. Toque em uma foto para ampliar. Os códigos ACF facilitam a identificação durante a revisão.</p>
  </div>
  <div class="filter-bar" role="group" aria-label="Filtrar fotografias do píer">
   {[{id:'todos',label:'Todas as 46 fotos'},{id:'panoramas',label:'Vistas gerais'},{id:'detalhes',label:'Guarda-corpos e detalhes'},{id:'contexto',label:'Ambientes e circulação'}].map(f=><button type="button" data-filter={f.id} aria-pressed={f.id==='todos'}>{f.label}</button>)}
  </div>
  <p class="sr-only" data-gallery-status role="status" aria-live="polite"></p>
  <div class="gallery-grid">
   {pier.map(photo=><figure data-category={categoryFor(photo)}>
    <button type="button" class="zoom-photo" aria-label={'Ampliar '+photo.id+': '+photo.alt} data-zoom>
     <Photo id={photo.id} sizes="(max-width:650px) 100vw, (max-width:1100px) 50vw, 33vw"/>
     <span aria-hidden="true">↗</span>
    </button>
    <figcaption><span class="eyebrow">{photo.id} / {labels[categoryFor(photo)]}</span><h2>{photo.application.replace(/^Píer de Cubatão\s*\/\s*/,'')}</h2></figcaption>
   </figure>)}
  </div>
 </section>
 <section class="wrap"><div class="related"><span class="eyebrow">Outros registros</span><div><h2>Conheça outras aplicações.</h2><p>Veja corrimãos para escadarias, rampas e guarda-corpos em diferentes tipos de edifício.</p><a class="text-link" href="/obras-realizadas/">Voltar ao portfólio ↗</a></div></div></section>
 <Callout/>
</Layout>
